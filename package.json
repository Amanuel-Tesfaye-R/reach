{
  "name": "@amanuel-tesfaye-r/reach",
  "version": "1.0.0",
  "description": "Your PC and its configured AI agent, always within reach. Carry your desktop identity, memory, files, and full workstation execution into Telegram 24/7.",
  "main": "src/bridge.mjs",
  "type": "module",
  "files": [
    "src",
    "scripts",
    "docs",
    "config.example.json",
    ".env.example",
    "requirements.txt",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "VISION.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "start": "node src/supervisor.mjs",
    "bridge": "node src/bridge.mjs",
    "setup": "node scripts/setup.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --check src/bridge.mjs src/supervisor.mjs src/notify.mjs src/sentinel.mjs scripts/setup.mjs scripts/verify.mjs && node --test tests/*.test.mjs"
  },
  "keywords": [
    "reach",
    "ai-agent",
    "ai-agents",
    "personal-ai-assistant",
    "telegram",
    "telegram-bot",
    "remote-pc",
    "remote-access",
    "self-hosted",
    "claude-code",
    "gemini",
    "whisper",
    "edge-tts",
    "voice-assistant",
    "chatops",
    "automation"
  ],
  "author": "Amanuel Tesfaye <https://github.com/Amanuel-Tesfaye-R>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amanuel-Tesfaye-R/reach.git"
  },
  "bugs": {
    "url": "https://github.com/Amanuel-Tesfaye-R/reach/issues"
  },
  "homepage": "https://github.com/Amanuel-Tesfaye-R/reach#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
